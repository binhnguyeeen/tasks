{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tasks-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "TIMEZONE": "Asia/Ho_Chi_Minh",
    "HOMEPAGE_URL": "https://binhnguyeeen.github.io/tasks/"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TasksMCP"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "TasksMCP"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "9b6e52d928784c13bdd8bf69c57a89a5"
    }
  ],
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8788
  }
}
